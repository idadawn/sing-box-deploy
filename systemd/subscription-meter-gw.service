[Unit]
Description=Record subscription traffic counters without enforcing limits
After=network-online.target sing-box-gw.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/subscription-meter-gw/collector.py /etc/subscription-meter-gw/config.json
User=root
UMask=0077
StateDirectory=subscription-meter-gw
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/subscription-meter-gw
